# ============================================================
# Variables de entorno para Docker
# ============================================================
#   1. Copia este archivo y renómbralo como ".env"
#   2. Edita las contraseñas
#   3. El docker-compose.yml leerá este archivo automáticamente
# ============================================================

# ── Aplicación ───────────────────────────────────────────
APP_NAME=MerulinkBack
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

# ── Clave de la aplicación Laravel ───────────────────────
# Genera una nueva con: php artisan key:generate
# APP_KEY=base64:

# ── Base de datos (PostgreSQL) ───────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=baseName
DB_USERNAME=baseUserName
DB_PASSWORD=securePassword

# ── Seeders (control manual) ─────────────────────────────
# true  → corre los seeders en cada arranque del backend
# false → NO los corre
RUN_SEEDERS=false

# ── Sesiones (guardadas en base de datos) ────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Colas (guardadas en base de datos) ───────────────────
QUEUE_CONNECTION=database

# ── Cache ────────────────────────────────────────────────
CACHE_STORE=file

# ── Logs ─────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Correo ───────────────────
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
